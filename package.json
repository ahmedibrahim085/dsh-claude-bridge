{
  "name": "dsh-turn-events",
  "version": "0.1.0",
  "description": "Machine-readable finished-turn events for DeepSeek Harness (dsh): one JSONL line per turn, plus an event-driven wait CLI so Claude Code, scripts and CI can react when dsh is done.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-wait-turn": "bin/dsh-wait-turn",
    "dsh-turns": "bin/dsh-turns"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "notify",
      "summary": "Writes one JSON line per finished dsh turn so other agents, scripts and CI can react without polling.",
      "capabilities": [
        "turn-events-jsonl",
        "event-driven-wait-cli",
        "no-shell",
        "no-network"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/ && sh test/wait-turn.test.sh"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "events",
    "notifications",
    "agents",
    "claude-code",
    "acp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedibrahim085/dsh-turn-events.git"
  },
  "homepage": "https://github.com/ahmedibrahim085/dsh-turn-events#readme",
  "bugs": "https://github.com/ahmedibrahim085/dsh-turn-events/issues",
  "license": "MIT"
}
