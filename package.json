{
  "name": "dsh-claude-bridge",
  "version": "0.2.3",
  "description": "Claude Code <-> DeepSeek Harness (dsh) bridge: finished-turn events, an event-driven wait CLI, doctor/setup for acpx, mcacp and the Claude Code helpers (provider and Claude brains), and the dsh-harness skill.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-claude-bridge": "bin/dsh-claude-bridge",
    "dsh-wait-turn": "bin/dsh-wait-turn",
    "dsh-turns": "bin/dsh-turns"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "bin/",
    "skills/",
    "README.md",
    "CHANGELOG.md",
    "MAINTENANCE.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "category": "integration",
      "summary": "Bridges Claude Code and dsh: turn events, wait CLI, setup/doctor for acpx, mcacp and Claude Code helpers on two brains.",
      "capabilities": [
        "turn-events-jsonl",
        "event-driven-wait-cli",
        "setup-doctor",
        "claude-code-helpers",
        "claude-code-skill"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs && sh test/wait-turn.test.sh && python3 -m unittest discover -s test -p 'test_*.py'"
  },
  "keywords": [
    "acp",
    "agents",
    "bridge",
    "claude-code",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "events",
    "mcp",
    "notifications"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahmedibrahim085/dsh-claude-bridge.git"
  },
  "homepage": "https://github.com/ahmedibrahim085/dsh-claude-bridge#readme",
  "bugs": "https://github.com/ahmedibrahim085/dsh-claude-bridge/issues",
  "license": "MIT"
}
