#!/usr/bin/env python3
"""dsh-wait-turn: block until the next dsh turn finishes, print its event line, exit.

Event-driven on macOS/BSD: sleeps on a kernel kqueue watch of the event file (no polling), so a
waiting `claude -p` run, script or CI step costs no CPU; elsewhere it checks the file size once a
second. Lines come from the dsh-turn-events plugin (DSH_TURN_EVENTS_FILE overrides the path):
  {"ts","event":"turn-stopping","session_id","cwd","turn","agent_preset"}

Usage:
  dsh-wait-turn [--session ID] [--cwd PATH] [--timeout SECONDS]
    --session  match a dsh session id (any part of it, e.g. the short id d06e3c3a)
    --cwd      match the session's working directory (use this with acpx: its ids differ from dsh's)
    --timeout  give up after SECONDS (default 1800); exit 2 on timeout, 0 when a turn matched
"""
import argparse, json, os, select, sys, time
from pathlib import Path

EVENTS = Path(os.environ.get("DSH_TURN_EVENTS_FILE", Path.home() / ".local/state/dsh-events/turns.jsonl"))


def matches(ev, a):
    sid = ev.get("session_id") or ""
    if a.session and a.session not in sid:
        return False
    if a.cwd and os.path.realpath(ev.get("cwd") or "") != os.path.realpath(a.cwd):
        return False
    return True


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--session")
    ap.add_argument("--cwd")
    ap.add_argument("--timeout", type=float, default=1800)
    a = ap.parse_args()
    EVENTS.parent.mkdir(parents=True, exist_ok=True)
    EVENTS.touch(exist_ok=True)
    deadline = time.monotonic() + a.timeout
    with open(EVENTS, "rb") as fh:
        fh.seek(0, os.SEEK_END)  # only turns that finish from now on
        if hasattr(select, "kqueue"):  # macOS / BSD: the kernel wakes us on each write, no polling
            kq = select.kqueue()
            ev = select.kevent(fh.fileno(), filter=select.KQ_FILTER_VNODE,
                               flags=select.KQ_EV_ADD | select.KQ_EV_CLEAR,
                               fflags=select.KQ_NOTE_WRITE | select.KQ_NOTE_EXTEND)
            sleep = lambda left: kq.control([ev], 1, left)
        else:  # SHORTCUT: Linux has no kqueue in the stdlib; a 1 s size check. Upgrade path: inotify.
            def sleep(left):
                size = os.fstat(fh.fileno()).st_size
                end = time.monotonic() + left
                while os.fstat(fh.fileno()).st_size == size and time.monotonic() < end:
                    time.sleep(min(1.0, max(0.0, end - time.monotonic())))
        buf = b""
        while True:
            *lines, buf = (buf + fh.read()).split(b"\n")  # keep a half-written last line for the next wake
            for raw in lines:
                try:
                    e = json.loads(raw)
                except ValueError:
                    continue
                if matches(e, a):
                    print(json.dumps(e), flush=True)
                    return 0
            left = deadline - time.monotonic()
            if left <= 0:
                print(json.dumps({"timeout": True, "session": a.session, "cwd": a.cwd}), file=sys.stderr)
                return 2
            sleep(left)  # until the file grows or the deadline


if __name__ == "__main__":
    sys.exit(main())
