#!/usr/bin/env python3
"""dsh-turns: one-shot lookup of finished DeepSeek Harness turns, with each turn's reply text.

Read-only over ~/.dsh/sessions (each session is a zstd-compressed JSONL event log). For live,
event-driven notification use the dsh-turn-events plugin (~/.local/state/dsh-events/turns.jsonl)
with `tail -F`; this tool is for "what did dsh answer?" after such an event, so it never loops.
One JSON line per finished turn:
  {"ts", "session_id", "cwd", "title", "turn", "reason", "reply"}

Usage:
  dsh-turns                      turns that finished since the last call (cursor in ~/.local/state)
  dsh-turns --since 10m          turns finished in the last 10 minutes (s/m/h/d), cursor untouched
  dsh-turns --session ID         only that session (any part of the id is enough)
"""
import argparse, json, os, re, subprocess, sys, time
from pathlib import Path

HOME = Path.home()
SESSIONS = Path(os.environ.get("DSH_HOME", HOME / ".dsh")) / "sessions"
CURSOR = Path(os.environ.get("DSH_TURNS_STATE", HOME / ".local/state/dsh-turns/cursor"))
REPLY_CHARS = 400


def log_files(newer_than_ms):
    """Session logs modified after the given epoch-ms (mtime prefilter keeps each scan cheap)."""
    if not SESSIONS.is_dir():
        return []
    cutoff = newer_than_ms / 1000 - 2
    return [p for p in SESSIONS.glob("*/*/session.v*.jsonl.zstd") if p.stat().st_mtime >= cutoff]


def read_events(path):
    """Decode a (possibly still growing) zstd log; a torn last frame yields what decoded cleanly."""
    try:
        out = subprocess.run(["zstd", "-dcq", str(path)], capture_output=True, timeout=30).stdout
    except (OSError, subprocess.TimeoutExpired):
        return []
    events = []
    for line in out.decode("utf-8", "replace").splitlines():
        try:
            events.append(json.loads(line))
        except ValueError:
            continue  # partial trailing line of a live session
    return events


def finished_turns(path, after_ms):
    events = read_events(path)
    title, cwd, replies = None, None, {}
    for e in events:
        t, d = e.get("type"), e.get("data") or {}
        if t == "session" and cwd is None:
            cwd = e.get("cwd")  # first log line: session header with top-level cwd
        if t and "title" in t and isinstance(d.get("title"), str):
            title = d["title"]
        if t == "assistant/message":
            msg = d.get("message") or {}
            text = "".join(c.get("text", "") for c in msg.get("content", []) if c.get("type") == "text")
            if text:
                replies[d.get("turn")] = text
    for e in events:
        if e.get("type") != "turn/end" or e.get("time", 0) <= after_ms:
            continue
        d = e.get("data") or {}
        reply = replies.get(d.get("turn"), "")
        yield {
            "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(e["time"] / 1000)),
            "time_ms": e["time"],
            "session_id": path.parent.name,
            "cwd": cwd,
            "title": title,
            "turn": d.get("turn"),
            "reason": (d.get("reason") or {}).get("kind"),
            "reply": reply[:REPLY_CHARS] + ("…" if len(reply) > REPLY_CHARS else ""),
        }


def scan(after_ms, session=None):
    found = []
    for p in log_files(after_ms):
        if session and session not in p.parent.name:
            continue
        found.extend(finished_turns(p, after_ms))
    return sorted(found, key=lambda r: r["time_ms"])


def parse_since(s):
    m = re.fullmatch(r"(\d+)([smhd])", s)
    if not m:
        sys.exit("--since takes a duration like 30s, 10m, 2h, 1d")
    return int(time.time() * 1000) - int(m.group(1)) * {"s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)] * 1000


def emit(rows):
    for r in rows:
        r = {k: v for k, v in r.items() if k != "time_ms"}
        print(json.dumps(r, ensure_ascii=False), flush=True)


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--since")
    ap.add_argument("--session")
    a = ap.parse_args()
    now = int(time.time() * 1000)
    if a.since:
        after = parse_since(a.since)
    else:
        try:
            after = int(CURSOR.read_text().strip())
        except (OSError, ValueError):
            after = now - 3600 * 1000  # first run: last hour
    rows = scan(after, a.session)
    emit(rows)
    if not a.since:
        CURSOR.parent.mkdir(parents=True, exist_ok=True)
        CURSOR.write_text(str(rows[-1]["time_ms"] if rows else now))
    return 0


if __name__ == "__main__":
    sys.exit(main())
